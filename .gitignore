# Build output
/bin/
/dist/

# Local server data (DB + blobs)
/data/

# Go
*.test
*.out
coverage.*

# Editors / OS
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# UI
node_modules/
# Built UI is generated by `make build`; only the placeholder is committed
# so `go build` works before the UI has ever been built.
/server/internal/webui/dist/*
!/server/internal/webui/dist/.gitkeep

# Desktop client
/client/build/bin/
# stray outputs of `go build` run inside client/
/client/client
/client/*.exe
/client/*.syso
/client/frontend/dist/*
!/client/frontend/dist/.gitkeep

# Python
__pycache__/

# Release and package outputs (built by scripts/ and CI, never committed)
*.deb
*.msix
*.appx
*.exe
*.syso
/client/rsrc*
*.tar.gz
nulldrive_*_docker_*.tar
SHA256SUMS.txt

# Certificates and secrets
*.pfx
*.p12
*.pem
*.key
.env
.env.*

# Test runs
/ui/.e2e-data/
/ui/test-results/
/ui/playwright-report/
/client/frontend/test-results/
