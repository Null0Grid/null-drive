{
  "name": "@nulldrive/ui",
  "private": true,
  "version": "5.0.0",
  "description": "Null Drive UI: the shared Svelte component library (src/lib) and the web app (src/web).",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/lib/index.ts",
    "./styles/*": "./src/lib/styles/*"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test --project=e2e",
    "screenshots": "playwright test --project=screenshots"
  },
  "devDependencies": {
    "@playwright/test": "1.56.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/svelte": "^5.4.2",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "jsdom": "^29.1.1",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/silkscreen": "^5.3.0",
    "@fontsource/vt323": "^5.3.0",
    "libsodium-wrappers-sumo": "0.8.4",
    "qrcode-generator": "1.4.4"
  }
}
